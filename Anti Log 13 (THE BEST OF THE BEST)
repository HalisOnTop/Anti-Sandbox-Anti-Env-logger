local function _state()
    local s, r = pcall(function()
        local folder = Instance.new("Folder")
        folder.Name = "_f" .. math.random(1000, 9999)
        
        local p1 = Instance.new("Part")
        p1.Name = "p1"
        p1.Anchored = true
        p1.Parent = folder
        
        local p2 = Instance.new("Part")
        p2.Name = "p2"
        p2.Anchored = true
        p2.Parent = folder
        
        local descs = folder:GetDescendants()
        if typeof(descs) ~= "table" or #descs ~= 2 then
            folder:Destroy()
            return false
        end
        
        local clonedFolder = folder:Clone()
        if clonedFolder.Parent ~= nil or #clonedFolder:GetChildren() ~= 2 then
            folder:Destroy()
            clonedFolder:Destroy()
            return false
        end
        
        folder:ClearAllChildren()
        if #folder:GetChildren() ~= 0 then
            folder:Destroy()
            clonedFolder:Destroy()
            return false
        end
        
        local part = Instance.new("Part")
        part.Material = Enum.Material.Glass
        if part.Material ~= Enum.Material.Glass then
            part:Destroy()
            folder:Destroy()
            clonedFolder:Destroy()
            return false
        end
        
        part.Material = Enum.Material.Wood
        if part.Material ~= Enum.Material.Wood then
            part:Destroy()
            folder:Destroy()
            clonedFolder:Destroy()
            return false
        end
        
        part:Destroy()
        folder:Destroy()
        clonedFolder:Destroy()
        return true
    end)
    return s and r == true
end

if _state() then
    print("pass")
else
    print("detected")
    return
end
